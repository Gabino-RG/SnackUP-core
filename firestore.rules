rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas existentes del proyecto.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId;
      allow update, delete: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId;
    }
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId
      );
      allow delete: if false;
    }
    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Las dos colecciones de valoraciones necesitan permisos explícitos.
    function validReview(data) {
      let order = get(/databases/$(database)/documents/orders/$(data.orderId)).data;
      return request.auth != null
        && data.userId == request.auth.uid
        && order.userId == request.auth.uid
        && order.status == 'completed'
        && data.businessId == order.businessId
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 300
        && data.userName is string && data.anonymous is bool
        && data.updatedAt == request.time;
    }
    function sameReviewOwner() {
      return request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.businessId == resource.data.businessId;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if validReview(request.resource.data)
        && request.resource.data.type == 'product'
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && reviewId == request.resource.data.orderId + '_' + request.resource.data.productId
        && request.resource.data.keys().hasOnly([
          'type', 'orderId', 'productId', 'productName', 'businessId',
          'userId', 'userName', 'anonymous', 'rating', 'comment', 'updatedAt'
        ]);
      allow update: if validReview(request.resource.data) && sameReviewOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type', 'userName', 'anonymous', 'rating', 'comment', 'updatedAt'
        ]) && request.resource.data.type == 'product';
      allow delete: if false;
    }
    match /restaurant_reviews/{reviewId} {
      allow read: if true;
      allow create: if validReview(request.resource.data)
        && request.resource.data.type == 'restaurant'
        && reviewId == request.resource.data.orderId
        && request.resource.data.keys().hasOnly([
          'type', 'orderId', 'businessId', 'userId', 'userName',
          'anonymous', 'rating', 'comment', 'updatedAt'
        ]);
      allow update: if validReview(request.resource.data) && sameReviewOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type', 'userName', 'anonymous', 'rating', 'comment', 'updatedAt'
        ]) && request.resource.data.type == 'restaurant';
      allow delete: if false;
    }
  }
}
