{
    admin off
    auto_https off
    persist_config off
}
:8080 {
    header -Server
    header Cache-Control "no-store"
    root * /srv
    handle /healthz {
        respond "ok" 200
    }
    @backend path /api /api/* /socket.io /socket.io/* /media /media/*
    handle @backend {
        respond "API must be routed by the public backend proxy" 404
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
