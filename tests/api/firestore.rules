// SNACKUP_RULES_PENDING
// MARCADOR DE SEGURIDAD, NO SON LAS REGLAS DE SNACKUP.
// Sustituir por una copia de las reglas REALES autorizadas del proyecto.
// No ejecutar firebase deploy con este archivo.
// El runner se detiene mientras este marcador siga presente.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
