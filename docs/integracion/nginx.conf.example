# Referencia: completar dominio, certificados, ruta web y puerto del backend.
# Incluir en el contexto http de Nginx. No es una configuración ya desplegada.
map $http_upgrade $snackup_connection {
    default upgrade;
    '' close;
}
upstream snackup_backend {
    server 127.0.0.1:8080;
}
server {
    listen 443 ssl;
    server_name cafeteria.example;
    ssl_certificate /ruta/certificado.pem;
    ssl_certificate_key /ruta/clave.pem;
    root /srv/snackup/web;
    index index.html;
    client_max_body_size 6m;

    # Sin URI final en proxy_pass: conservar /api/v1/ para el backend.
    location ^~ /api/v1/ {
        proxy_pass http://snackup_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $snackup_connection;
        proxy_read_timeout 75s;
        proxy_intercept_errors off;
        # No fallback HTML ni cache de respuestas autenticadas.
    }
    location ^~ /media/ {
        proxy_pass http://snackup_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        try_files $uri $uri/ /index.html;
        # Flutter genera nombres estables: evitar mezclar versiones cacheadas.
        add_header Cache-Control "no-cache" always;
    }
}
