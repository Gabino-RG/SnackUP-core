    "/student/businesses/{id}/products": {
      "get": {
        "operationId": "listStudentProducts",
        "summary": "Consultar catálogo disponible de un local",
        "description": "Solo productos no eliminados y disponibles de un local activo; orden categoría, nombre e ID. stock=null significa inventario sin límite de unidades configurado. Precios e inventario vuelven a comprobarse al comprar.",
        "tags": [
          "student"
        ],
        "responses": {
          "200": {
            "description": "Operación confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "default": {
            "description": "Error sin efectos no autorizados. El cliente conserva error.code; ver API_ALUMNOS.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-required-role": "user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/student/orders": {
      "post": {
        "operationId": "createStudentOrder",
        "summary": "Crear pedido con reserva de existencias",
        "description": "Solo cash. El servidor fija precios, cantidades disponibles, total, número y código de entrega; reserva existencias transaccionalmente. No admite productos duplicados, precios enviados por cliente ni pedidos a varios locales. Misma clave y mismo body devuelve el JSON original (201), incluso si el pedido avanzó desde entonces: consultar GET después. Misma clave con otro body: 409 IDEMPOTENCY_CONFLICT. Límite de creación/reintentos: 30/minuto por usuario. No hay procesamiento de pago electrónico.",
        "tags": [
          "student"
        ],
        "responses": {
          "201": {
            "description": "Operación confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentOrder"
                }
              }
            }
          },
          "default": {
            "description": "Error sin efectos no autorizados. El cliente conserva error.code; ver API_ALUMNOS.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-required-role": "user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentOrderInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{16,128}$"
            },
            "description": "Clave nueva por intención de compra, reutilizada sin cambiar el body cuando se desconoce el resultado. Ámbito del usuario autenticado."
          }
        ]
      },
      "get": {
        "operationId": "listStudentOrders",
        "summary": "Listar únicamente pedidos propios",
        "description": "Ordenados del más reciente al más antiguo, con ID como desempate. No filtra por estado. Incluye pickupCode solo para el propietario.",
        "tags": [
          "student"
        ],
        "responses": {
          "200": {
            "description": "Operación confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentOrderPage"
                }
              }
            }
          },
          "default": {
            "description": "Error sin efectos no autorizados. El cliente conserva error.code; ver API_ALUMNOS.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-required-role": "user",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 20
            }
          }
        ]
      }
    },
    "/student/orders/{id}": {
      "get": {
        "operationId": "getStudentOrder",
        "summary": "Consultar un pedido propio",
        "description": "Un pedido de otra persona se responde como inexistente (404). Incluye código privado del propietario; Cocina usa el DTO distinto del contrato de paneles.",
        "tags": [
          "student"
        ],
        "responses": {
          "200": {
            "description": "Operación confirmada",
            "content": {
              "application/json": {
                "schema": {
