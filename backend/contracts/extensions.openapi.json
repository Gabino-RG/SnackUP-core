{
  "openapi": "3.1.0",
  "info": {
    "title": "SnackUP - extensiones de identidad y alumnado",
    "version": "0.1.0",
    "description": "Contrato del backend implementado en snackup/identity.py, operations.py y admin.py. 11 operaciones adicionales y la ampliación compatible del perfil existente. No sustituye ni modifica las 43 operaciones de panels.openapi.json. El frontend estudiantil existente aún requiere integración REST; no hay API, padrón, SMTP ni servidor institucional entregados por este documento."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "public",
      "description": "Sin sesión; acuses genéricos y límites antiabuso."
    },
    {
      "name": "student",
      "description": "role=user, correo confirmado, cuenta activa/aprobada y padrón institucional activo de tipo student."
    },
    {
      "name": "authenticated",
      "description": "Perfil de la propia sesión; nunca consulta académica de otra persona."
    }
  ],
  "paths": {
    "/student/register": {
      "post": {
        "operationId": "registerStudent",
        "summary": "Solicitar alta de alumno mediante padrón",
        "description": "SMTP y dominios estudiantiles configurados obligatorios. Solo crea role=user cuando el correo coincide con un registro student activo y el dominio está permitido. Nombre, carrera y grupo vienen del padrón. El correo aún debe verificarse. 202 es genérico también para duplicados, correos no autorizados o inexistentes; no devuelve sesión ni confirma elegibilidad. Campos de rol/carrera inyectados se rechazan.",
        "tags": [
          "public"
        ],
        "responses": {
          "202": {
            "description": "Operación confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Received"
                }
              }
            }
          },
          "default": {
            "description": "Error sin efectos no autorizados. El cliente conserva error.code; ver API_ALUMNOS.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-required-role": "public",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentRegistration"
              }
            }
          }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "operationId": "verifyEmail",
        "summary": "Confirmar posesión del correo",
        "description": "Token opaco de 30 minutos, vinculado al correo, de un solo uso. No concede roles ni sesión. En solicitudes de personal solo marca correo confirmado; mantiene autorización pendiente. Token inválido, usado o expirado: 422 VERIFICATION_TOKEN_INVALID.",
        "tags": [
          "public"
        ],
        "responses": {
          "204": {
            "description": "Operación confirmada"
          },
          "default": {
            "description": "Error sin efectos no autorizados. El cliente conserva error.code; ver API_ALUMNOS.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-required-role": "public",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Debe coincidir exactamente con SNACKUP_PUBLIC_ORIGIN; también lo envían explícitamente clientes nativos de confianza."
          }
        ]
      },
      "get": {
        "operationId": "emailVerificationPage",
        "summary": "Abrir pantalla de confirmación de correo",
        "description": "HTML. El correo apunta a /api/v1/auth/verify-email#token=...; el fragmento no se envía al servidor. JavaScript lo retira de la barra y envía el POST solo tras pulsar Confirmar correo. GET no modifica datos. No pasar el token en query parameters. Respuesta con CSP de nonce y Cache-Control no-store.",
        "tags": [
          "public"
        ],
        "responses": {
          "200": {
            "description": "Página de confirmación sin cambios de estado.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error sin efectos no autorizados. El cliente conserva error.code; ver API_ALUMNOS.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-required-role": "public",
        "security": []
      }
    },
    "/auth/resend-verification": {
      "post": {
        "operationId": "resendVerification",
        "summary": "Reenviar confirmación de correo",
        "description": "Respuesta genérica aunque no exista la cuenta. Si existe, no está verificada y no fue rechazada, invalida tokens previos y envía uno nuevo. SMTP no configurado o entrega fallida: 503 EMAIL_UNAVAILABLE.",
        "tags": [
          "public"
        ],
        "responses": {
          "202": {
            "description": "Operación confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Received"
                }
              }
            }
          },
          "default": {
            "description": "Error sin efectos no autorizados. El cliente conserva error.code; ver API_ALUMNOS.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-required-role": "public",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailInput"
              }
            }
          }
        }
      }
    },
    "/student/businesses": {
      "get": {
        "operationId": "listStudentBusinesses",
        "summary": "Consultar locales activos",
        "description": "Solo locales activos, ordenados por nombre e ID. Incluye isOpen: un local cerrado sigue siendo visible, pero no acepta pedidos.",
        "tags": [
          "student"
        ],
        "responses": {
