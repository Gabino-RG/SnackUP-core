              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/users/me": {
      "get": {
        "operationId": "getProfileWithAcademics",
        "summary": "Leer perfil propio con información académica validada",
        "description": "Ruta ya definida en panels.openapi.json; aquí se documentan campos adicionales compatibles. Se conservan id,displayName,role,businessId,isMaster. Añade email,emailVerified y academic cuando hay padrón activo. La carrera se obtiene de esa relación SQL, no se deduce del texto del correo. Un padrón existente inactivo bloquea cualquier rol; personal sin padrón puede conservar permisos asignados manualmente.",
        "tags": [
          "authenticated"
        ],
        "responses": {
          "200": {
            "description": "Operación confirmada",
            "content": {
