            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/student/orders/{id}/cancel": {
      "post": {
        "operationId": "cancelStudentOrder",
        "summary": "Cancelar un pedido propio pendiente",
        "description": "Solo estado pending y expectedVersion vigente. Devuelve existencias reservadas una sola vez y marca cancelReason=student_cancelled. El alumno no envía motivo libre ni notas. Después de aceptación por Cocina: 409 INVALID_STATUS_TRANSITION. Versión anterior: 409 VERSION_CONFLICT.",
        "tags": [
          "student"
        ],
        "responses": {
          "200": {
            "description": "Operación confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentOrder"
                }
              }
            }
          },
          "default": {
