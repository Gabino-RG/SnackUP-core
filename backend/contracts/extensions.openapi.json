        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/student/orders/{id}/review": {
      "post": {
        "operationId": "createStudentReview",
        "summary": "Opinar sobre un pedido propio entregado",
        "description": "Solo pedido completed, una opinión por pedido. rating obligatorio; foodRating y serviceRating pueden omitirse o ser null. Carrera/grupo se copian del padrón vigente al enviar la opinión; nunca se aceptan desde el cliente. Cambios posteriores del padrón no reescriben esa copia. Opinión repetida: 409 REVIEW_EXISTS. Sin entrega: 409 ORDER_NOT_COMPLETED. La respuesta no revela identidad personal.",
        "tags": [
          "student"
        ],
        "responses": {
          "201": {
            "description": "Operación confirmada",
            "content": {
              "application/json": {
                "schema": {
