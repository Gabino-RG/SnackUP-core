// Reseña de producto comprado: unicidad por pedidoId + platilloId, distinta de reviews.
model Resena {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  pedidoId String @map("order_id") @db.Text
  platilloId String @map("product_id") @db.Text
  alumnoId String @map("user_id") @db.Text
  puntuacion Int @map("rating") @db.Integer
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  comentario String @map("comment") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow(); onupdate=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  alumno Usuario @relation("product_reviews_user_id", fields: [alumnoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pedido Pedido @relation("product_reviews_order_id", fields: [pedidoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
