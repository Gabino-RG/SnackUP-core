  @@unique([pedidoId, platilloId], map: "uq_product_review_order_product")
  @@index([platilloId, createdAt, id], map: "ix_product_reviews_product_created")
  @@index([alumnoId], map: "ix_product_reviews_user")
  // SQL/Alembic, CHECK [ck_product_review_rating]: rating BETWEEN 0 AND 5.
  @@map("product_reviews")
}


// Tabla histórica reviews = calificación del negocio, con carrera/grupo y seguimiento administrativo.
