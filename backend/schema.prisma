  id String @id @map("id") @db.Text
  pedidoId String @unique(map: "uq_review_order") @map("order_id") @db.Text
  alumnoId String @map("user_id") @db.Text
  negocioId String @map("business_id") @db.Text
  puntuacion Int? @map("rating") @db.Integer
  puntuacionComida Int? @map("food_rating") @db.Integer
  puntuacionServicio Int? @map("service_rating") @db.Integer
  carreraId String? @map("career_id") @db.Text
  grupoId String? @map("group_id") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  nombreCarreraSnapshot String @map("career_name") @db.VarChar(200)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  nombreGrupoSnapshot String @map("group_name") @db.VarChar(200)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  comentario String @map("comment") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow(); onupdate=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  alumno Usuario @relation("reviews_user_id", fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  carrera Carrera? @relation("reviews_career_id", fields: [carreraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grupo GrupoAcademico? @relation("reviews_group_id", fields: [grupoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  negocio Negocio @relation("reviews_business_id", fields: [negocioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedido Pedido @relation("reviews_order_id", fields: [pedidoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
