  claveAlmacenamiento String @unique @map("filename") @db.VarChar(80)
  tipoMime String @map("mime_type") @db.VarChar(30)
  tamanoBytes Int @map("size") @db.Integer
  ancho Int? @map("width") @db.Integer
  alto Int? @map("height") @db.Integer
