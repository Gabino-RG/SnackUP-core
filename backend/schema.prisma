// averageRating y totalRatings/totalResenas se calculan desde product_reviews; no son columnas.
// stock NULL significa sin límite; disponibilidadManual conserva la pausa del operador al devolver stock.
// categoria es texto libre, sin enum PostgreSQL de categorías.
model Platillo {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  negocioId String @map("business_id") @db.Text
  nombre String @map("name") @db.VarChar(160)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  descripcion String @map("description") @db.VarChar(2000)
  categoria String @map("category") @db.VarChar(120)
  subcategoria String? @map("subcategory") @db.VarChar(80)
  tiempoPreparacion Int? @map("preparation_minutes") @db.Integer
  calorias Int? @map("calories") @db.Integer
  precio Decimal @map("price") @db.Decimal(12, 2)
  stock Int? @map("stock") @db.Integer
  imagenUrl String? @map("image_url") @db.VarChar(2048)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=true.
  estaDisponible Boolean @map("is_available") @db.Boolean
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=true.
  disponibilidadManual Boolean @map("manual_available") @db.Boolean
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=false.
  esDestacado Boolean @map("is_featured") @db.Boolean
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=false.
  estaEliminado Boolean @map("is_deleted") @db.Boolean
  eliminadoAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=1.
  version Int @map("version") @db.Integer
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  carritos ItemCarrito[] @relation("cart_items_product_id")
  detallesPedido DetallePedido[] @relation("order_items_product_id")
  favoritos Favorito[] @relation("favorites_product_id")
  negocio Negocio @relation("products_business_id", fields: [negocioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resenas Resena[] @relation("product_reviews_product_id")

  @@index([negocioId, estaDisponible], map: "ix_products_business_available")
  @@index([negocioId, estaEliminado, categoria], map: "ix_products_business_catalog")
  // SQL/Alembic, CHECK [sin nombre en metadata; PostgreSQL asigna el nombre]: price >= 0.01 AND price <= 10000.
  // SQL/Alembic, CHECK [sin nombre en metadata; PostgreSQL asigna el nombre]: stock IS NULL OR stock != 0 OR NOT is_available.
  // SQL/Alembic, CHECK [sin nombre en metadata; PostgreSQL asigna el nombre]: stock IS NULL OR stock >= 0.
  // SQL/Alembic, CHECK [sin nombre en metadata; PostgreSQL asigna el nombre]: version >= 1.
  // SQL/Alembic, CHECK [ck_product_calories]: calories IS NULL OR calories >= 0.
  // SQL/Alembic, CHECK [ck_product_preparation_minutes]: preparation_minutes IS NULL OR preparation_minutes >= 0.
  @@map("products")
}


// estado conserva pending/accepted/preparing/ready/completed/cancelled como VARCHAR con CHECK.
// isRated/fueCalificado se calcula por la existencia de reviews; no es una columna.
// codigoQr admite códigos históricos de hasta 32 caracteres; solo longitud 6 tiene unicidad parcial global.
// canceladoPorId y verificadoPorId son identificadores históricos TEXT sin FK, como en el ORM.
// stockRestaurado y DetallePedido.cantidadReservada previenen devoluciones duplicadas del inventario.
// subtotal permanece nullable para preservar filas históricas durante la transición.
model Pedido {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  negocioId String @map("business_id") @db.Text
  alumnoId String @map("student_id") @db.Text
  numeroPedido Int @map("order_number") @db.Integer
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=1.
  version Int @map("version") @db.Integer
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="pending".
  estado String @map("status") @db.VarChar(20)
  nombreAlumnoSnapshot String @map("customer_name") @db.VarChar(160)
  numeroControlSnapshot String? @map("customer_institutional_id") @db.VarChar(100)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="cash".
  metodoPago String @map("payment_method") @db.VarChar(30)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="pay_at_pickup".
  estadoPago String @map("payment_status") @db.VarChar(30)
  total Decimal @map("total") @db.Decimal(14, 2)
  subtotal Decimal? @map("subtotal") @db.Decimal(14, 2)
  codigoQr String @map("pickup_code") @db.VarChar(32)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  recogidaProgramadaAt DateTime? @map("scheduled_pickup_time") @db.Timestamptz(6)
  pickupSoonNotifiedAt DateTime? @map("pickup_soon_notified_at") @db.Timestamptz(6)
  aceptadoAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  preparandoAt DateTime? @map("preparing_at") @db.Timestamptz(6)
  listoAt DateTime? @map("ready_at") @db.Timestamptz(6)
  entregadoAt DateTime? @map("completed_at") @db.Timestamptz(6)
  canceladoAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  motivoCancelacion String? @map("cancel_reason") @db.VarChar(60)
  notasCancelacion String? @map("cancel_notes") @db.VarChar(500)
  canceladoPorId String? @map("cancelled_by") @db.Text
  canceladoPorRol String? @map("cancelled_by_role") @db.VarChar(16)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=false.
  stockRestaurado Boolean @map("stock_restored") @db.Boolean
  metodoVerificacion String? @map("verification_method") @db.VarChar(10)
  verificadoPorId String? @map("verified_by") @db.Text
  verificadoAt DateTime? @map("verified_at") @db.Timestamptz(6)

  alumno Usuario @relation("orders_student_id", fields: [alumnoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  calificacionNegocio CalificacionNegocio? @relation("reviews_order_id")
  chats ConversacionChat[] @relation("chats_order_id")
  clavesIdempotencia ClaveIdempotencia[] @relation("idempotency_records_order_id")
  detalles DetallePedido[] @relation("order_items_order_id")
  eventos EventoPedido[] @relation("order_transitions_order_id")
  negocio Negocio @relation("orders_business_id", fields: [negocioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resenas Resena[] @relation("product_reviews_order_id")
  usoVale UsoValeComida? @relation("meal_voucher_uses_order_id")

  @@unique([negocioId, numeroPedido], map: "uq_business_order_number")
  @@index([negocioId, estado, createdAt, id], map: "ix_orders_business_active")
  @@index([negocioId, canceladoAt], map: "ix_orders_business_cancelled")
  @@index([negocioId, entregadoAt], map: "ix_orders_business_completed")
  @@index([negocioId, estado, updatedAt, id], map: "ix_orders_business_updated")
  // SQL/Alembic, índice parcial: INDEX ix_orders_scheduled_alert_due (scheduled_pickup_time) WHERE scheduled_pickup_time IS NOT NULL AND pickup_soon_notified_at IS NULL AND status IN ('pending','accepted','preparing','ready').
  // No convertir este predicado a @unique/@@unique global en Prisma.
  @@index([alumnoId, createdAt, id], map: "ix_orders_student_created")
  @@index([alumnoId, estado], map: "ix_orders_student_status")
  // SQL/Alembic, índice parcial: UNIQUE INDEX uq_orders_v3_pickup_code (pickup_code) WHERE length(pickup_code) = 6.
  // No convertir este predicado a @unique/@@unique global en Prisma.
  // SQL/Alembic, CHECK [sin nombre en metadata; PostgreSQL asigna el nombre]: order_number >= 1 AND version >= 1 AND total >= 0.
  // SQL/Alembic, CHECK [sin nombre en metadata; PostgreSQL asigna el nombre]: status IN ('pending','accepted','preparing','ready','completed','cancelled').
  @@map("orders")
}


// nombreSnapshot/precioUnitario son snapshots de venta; cantidadReservada registra la reserva real.
model DetallePedido {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  pedidoId String @map("order_id") @db.Text
  platilloId String @map("product_id") @db.Text
  nombreSnapshot String @map("name") @db.VarChar(160)
  cantidad Int @map("quantity") @db.Integer
  precioUnitario Decimal @map("price") @db.Decimal(12, 2)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  notas String @map("notes") @db.VarChar(500)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=0.
  cantidadReservada Int @map("reserved_quantity") @db.Integer

  pedido Pedido @relation("order_items_order_id", fields: [pedidoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  platillo Platillo @relation("order_items_product_id", fields: [platilloId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([pedidoId], map: "ix_order_items_order_id")
  @@index([platilloId], map: "ix_order_items_product_id")
  // SQL/Alembic, CHECK [sin nombre en metadata; PostgreSQL asigna el nombre]: quantity > 0 AND price >= 0.
  // SQL/Alembic, CHECK [sin nombre en metadata; PostgreSQL asigna el nombre]: reserved_quantity >= 0 AND reserved_quantity <= quantity.
  @@map("order_items")
}


