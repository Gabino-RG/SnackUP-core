  @@index([negocioId, createdAt, id], map: "ix_reviews_business_created")
  // SQL/Alembic, CHECK [ck_review_food_rating]: food_rating IS NULL OR food_rating BETWEEN 0 AND 5.
  // SQL/Alembic, CHECK [ck_review_rating]: rating IS NULL OR rating BETWEEN 0 AND 5.
  // SQL/Alembic, CHECK [ck_review_service_rating]: service_rating IS NULL OR service_rating BETWEEN 0 AND 5.
  @@map("reviews")
}


