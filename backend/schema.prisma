// SnackUP - referencia PostgreSQL / Prisma ORM 7 del backend Python/FastAPI.
// GENERADO: python tools/export_prisma_reference.py. Verificar: añadir --check.
// Fuente de autoridad: snackup/*.py (Base.metadata) + migrations/ (Alembic).
// No usar Prisma Migrate ni db push sobre esta base; Prisma no integra el runtime.
// Vocabulario adaptado del schema.prisma suministrado; @map/@@map conservan el SQL real.
// No se inventan enums PostgreSQL, unicidades globales, columnas agregadas ni FK históricas.
// Los IDs opacos de entidades/FK son TEXT. El outbox conserva su secuencia interna Int.
// Los defaults/onupdate de Python se documentan y NO se transforman en DEFAULT SQL.
// SQLAlchemy JSON corresponde a @db.Json, no al JsonB que Prisma usaría por omisión.
// TIMESTAMP WITH TIME ZONE sin precisión explícita conserva la precisión PostgreSQL 6.
// Los CHECK y los índices parciales se documentan al pie de su modelo; Alembic los mantiene.
// No se declara generator: este archivo permite validar/consultar la referencia sin generar cliente Node.
// Prisma 7 ubica URLs de conexión en prisma.config.ts; validate no necesita conexión.
// Referencias: https://www.prisma.io/docs/orm/v7/reference/prisma-schema-reference
// https://www.prisma.io/docs/orm/v7/prisma-schema/data-model/database-mapping

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}


model ItemCarrito {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  usuarioId String @map("user_id") @db.Text
  platilloId String @map("product_id") @db.Text
  cantidad Int @map("quantity") @db.Integer
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  notas String @map("notes") @db.VarChar(500)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  platillo Platillo @relation("cart_items_product_id", fields: [platilloId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usuario Usuario @relation("cart_items_user_id", fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuarioId, platilloId], map: "uq_cart_user_product")
  @@index([usuarioId], map: "ix_cart_items_user_id")
  // SQL/Alembic, CHECK [ck_cart_quantity]: quantity BETWEEN 1 AND 99.
  @@map("cart_items")
}


model Favorito {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  usuarioId String @map("user_id") @db.Text
  platilloId String @map("product_id") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  notas String @map("notes") @db.VarChar(500)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  platillo Platillo @relation("favorites_product_id", fields: [platilloId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usuario Usuario @relation("favorites_user_id", fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuarioId, platilloId], map: "uq_favorite_user_product")
  @@index([usuarioId], map: "ix_favorites_user_id")
  @@map("favorites")
}


model UsoValeComida {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  usuarioId String @map("user_id") @db.Text
  pedidoId String @unique @map("order_id") @db.Text
  localDate DateTime @map("local_date") @db.Date
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="reserved".
  estado String @map("state") @db.VarChar(16)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  pedido Pedido @relation("meal_voucher_uses_order_id", fields: [pedidoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usuario Usuario @relation("meal_voucher_uses_user_id", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // SQL/Alembic, índice parcial: UNIQUE INDEX uq_meal_voucher_active_day (user_id, local_date) WHERE state IN ('reserved','consumed').
  // No convertir este predicado a @unique/@@unique global en Prisma.
  // SQL/Alembic, CHECK [ck_meal_voucher_state]: state IN ('reserved','consumed','released').
  @@map("meal_voucher_uses")
}


model ConversacionChat {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  alumnoId String @map("student_id") @db.Text
  negocioId String @map("business_id") @db.Text
  pedidoId String? @map("order_id") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  lastActivityAt DateTime @map("last_activity_at") @db.Timestamptz(6)

  alumno Usuario @relation("chats_student_id", fields: [alumnoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mensajes MensajeChat[] @relation("chat_messages_chat_id")
  negocio Negocio @relation("chats_business_id", fields: [negocioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pedido Pedido? @relation("chats_order_id", fields: [pedidoId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([alumnoId, negocioId], map: "uq_chat_participants")
  @@index([negocioId], map: "ix_chats_business_id")
  @@index([lastActivityAt], map: "ix_chats_last_activity_at")
  @@index([alumnoId], map: "ix_chats_student_id")
  @@map("chats")
}


model MensajeChat {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  chatId String @map("chat_id") @db.Text
  senderId String @map("sender_id") @db.Text
  senderRole String @map("sender_role") @db.VarChar(16)
  text String @map("text") @db.VarChar(1000)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  conversacion ConversacionChat @relation("chat_messages_chat_id", fields: [chatId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  remitente Usuario @relation("chat_messages_sender_id", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chatId, createdAt, id], map: "ix_chat_messages_created")
  // SQL/Alembic, CHECK [ck_chat_text]: length(text) BETWEEN 1 AND 1000.
  @@map("chat_messages")
}


model ComprobanteCierreChat {
  id String @id @map("id") @db.Text
  studentProof String @map("student_proof") @db.VarChar(64)
  businessProof String @map("business_proof") @db.VarChar(64)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  closedAt DateTime @map("closed_at") @db.Timestamptz(6)

  @@map("chat_closures")
}


// rol es VARCHAR: user -> ALUMNO, business -> COCINA, admin -> ADMIN; pending solo pertenece al flujo legacy.
// negocioId NO es único global: uq_active_business_operator limita solo operadores activos y aprobados.
// esMaestro conserva la protección administrativa existente; no es un cuarto rol público V3.
model Usuario {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  correo String @unique @map("email") @db.VarChar(254)
  nombre String @map("display_name") @db.VarChar(160)
  passwordHash String @map("password_hash") @db.VarChar(256)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="pending".
  rol String @map("role") @db.VarChar(16)
  negocioId String? @map("business_id") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=false.
  estaActivo Boolean @map("is_active") @db.Boolean
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=false.
  esMaestro Boolean @map("is_master") @db.Boolean
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="pending".
  estadoAprobacion String @map("approval_status") @db.VarChar(16)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=false.
  correoVerificado Boolean @map("email_verified") @db.Boolean
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=1.
  version Int @map("version") @db.Integer
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=1.
  versionAutenticacion Int @map("auth_version") @db.Integer
  numeroDeControl String? @unique(map: "uq_users_numero_de_control") @map("numero_de_control") @db.VarChar(100)
  avatarUrl String? @map("avatar_url") @db.VarChar(1000)
  verificadoInstitucionalAt DateTime? @map("institutional_verified_at") @db.Timestamptz(6)
  ultimoLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow(); onupdate=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  calificacionesNegocio CalificacionNegocio[] @relation("reviews_user_id")
  carrito ItemCarrito[] @relation("cart_items_user_id")
  chats ConversacionChat[] @relation("chats_student_id")
  clavesIdempotencia ClaveIdempotencia[] @relation("idempotency_records_user_id")
  decisionesEmitidas DecisionAcceso[] @relation("access_decisions_actor_id")
  decisionesRecibidas DecisionAcceso[] @relation("access_decisions_user_id")
  dispositivos Dispositivo[] @relation("devices_user_id")
  entregasPush EntregaPush[] @relation("push_deliveries_user_id")
  eventosAuditoria EventoAuditoriaCuenta[] @relation("account_audit_events_actor_id")
  eventosPedido EventoPedido[] @relation("order_transitions_actor_id")
  eventosSeguimiento EventoSeguimiento[] @relation("followup_events_actor_id")
  favoritos Favorito[] @relation("favorites_user_id")
  medios Medio[] @relation("media_files_owner_id")
  mensajes MensajeChat[] @relation("chat_messages_sender_id")
  negocio Negocio? @relation("users_business_id", fields: [negocioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedidos Pedido[] @relation("orders_student_id")
  refreshTokens RefreshToken[] @relation("refresh_sessions_user_id")
  resenas Resena[] @relation("product_reviews_user_id")
  solicitudAcceso SolicitudAcceso? @relation("access_requests_user_id")
  solicitudesRevisadas SolicitudAcceso[] @relation("access_requests_reviewed_by")
  tokensVerificacion TokenVerificacion[] @relation("verification_tokens_user_id")
  usosVale UsoValeComida[] @relation("meal_voucher_uses_user_id")

  // SQL/Alembic, índice parcial: UNIQUE INDEX uq_active_business_operator (business_id) WHERE role = 'business' AND is_active = true AND approval_status = 'approved'.
  // No convertir este predicado a @unique/@@unique global en Prisma.
  // SQL/Alembic, CHECK [ck_master_role]: NOT is_master OR role = 'admin'.
  // SQL/Alembic, CHECK [ck_user_approval]: approval_status IN ('approved','pending','rejected').
  // SQL/Alembic, CHECK [ck_user_business_role]: role = 'business' OR business_id IS NULL.
  // SQL/Alembic, CHECK [ck_user_role]: role IN ('admin','business','user','pending').
  @@map("users")
}


model Carrera {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  nombre String @map("name") @db.VarChar(160)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=true.
  estaActivo Boolean @map("is_active") @db.Boolean

  calificacionesNegocio CalificacionNegocio[] @relation("reviews_career_id")
  grupos GrupoAcademico[] @relation("academic_groups_career_id")
  registrosInstitucionales RegistroInstitucional[] @relation("academic_records_career_id")

  @@map("careers")
}


model GrupoAcademico {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  carreraId String @map("career_id") @db.Text
  nombre String @map("name") @db.VarChar(160)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=true.
  estaActivo Boolean @map("is_active") @db.Boolean

  calificacionesNegocio CalificacionNegocio[] @relation("reviews_group_id")
  carrera Carrera @relation("academic_groups_career_id", fields: [carreraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registrosInstitucionales RegistroInstitucional[] @relation("academic_records_group_id")

  @@index([carreraId], map: "ix_academic_groups_career_id")
  @@map("academic_groups")
}


// Padrón autorizado local. tipo student/staff y matrícula no los determina el cliente.
// La vinculación con Usuario usa correo en la aplicación; no existe una FK por correo en SQL.
model RegistroInstitucional {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  correo String @unique @map("email") @db.VarChar(254)
  identificadorInstitucional String @map("institutional_id") @db.VarChar(100)
  nombre String @map("display_name") @db.VarChar(160)
  tipo String @map("kind") @db.VarChar(16)
  carreraId String? @map("career_id") @db.Text
  grupoId String? @map("group_id") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=true.
  estaActivo Boolean @map("is_active") @db.Boolean
  fuente String @map("source") @db.VarChar(200)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow(); onupdate=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  carrera Carrera? @relation("academic_records_career_id", fields: [carreraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grupo GrupoAcademico? @relation("academic_records_group_id", fields: [grupoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tipo, identificadorInstitucional], map: "uq_roster_identity")
  // SQL/Alembic, CHECK [ck_roster_group_career]: group_id IS NULL OR career_id IS NOT NULL.
  // SQL/Alembic, CHECK [ck_roster_kind]: kind IN ('student','staff').
  // SQL/Alembic, CHECK [ck_student_career]: kind != 'student' OR career_id IS NOT NULL.
  @@map("academic_records")
}


model SolicitudAcceso {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  usuarioId String @unique @map("user_id") @db.Text
  correo String @map("email") @db.VarChar(254)
  nombre String @map("display_name") @db.VarChar(160)
  rolSolicitado String @map("requested_role") @db.VarChar(16)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  contextoSolicitud String @map("request_context") @db.VarChar(400)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="password".
  proveedor String @map("provider") @db.VarChar(16)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=false.
  correoVerificado Boolean @map("email_verified") @db.Boolean
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="pending".
  estadoAprobacion String @map("approval_status") @db.VarChar(16)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=1.
  version Int @map("version") @db.Integer
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  revisorId String? @map("reviewed_by") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  nota String @map("note") @db.VarChar(500)
  decididoAt DateTime? @map("decided_at") @db.Timestamptz(6)

  decision DecisionAcceso? @relation("access_decisions_request_id")
  revisor Usuario? @relation("access_requests_reviewed_by", fields: [revisorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario Usuario @relation("access_requests_user_id", fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([estadoAprobacion], map: "ix_access_requests_approval_status")
  // SQL/Alembic, CHECK [ck_request_approval]: approval_status IN ('pending','approved','rejected').
  // SQL/Alembic, CHECK [ck_requested_role]: requested_role IN ('admin','business').
  @@map("access_requests")
}


model DecisionAcceso {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  solicitudId String @unique(map: "uq_access_decision_request") @map("request_id") @db.Text
  usuarioId String @map("user_id") @db.Text
  actorId String @map("actor_id") @db.Text
  decision String @map("decision") @db.VarChar(20)
  rol String @map("role") @db.VarChar(20)
  negocioId String? @map("business_id") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  nota String @map("note") @db.VarChar(500)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  actor Usuario @relation("access_decisions_actor_id", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  negocio Negocio? @relation("access_decisions_business_id", fields: [negocioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  solicitud SolicitudAcceso @relation("access_decisions_request_id", fields: [solicitudId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario Usuario @relation("access_decisions_user_id", fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("access_decisions")
}


// datosRegistro contiene solo la intención temporal y, en recuperación pending, un hash; nunca contraseña plana.
// El consumo borra la intención; tokenHash almacena el hash de un token de un solo uso.
model TokenVerificacion {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  usuarioId String @map("user_id") @db.Text
  correo String @map("email") @db.VarChar(254)
  proposito String @map("purpose") @db.VarChar(16)
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  expiraAt DateTime @map("expires_at") @db.Timestamptz(6)
  utilizadoAt DateTime? @map("used_at") @db.Timestamptz(6)
  datosRegistro Json? @map("registration_data") @db.Json
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation("verification_tokens_user_id", fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiraAt], map: "ix_verification_tokens_expiry")
  @@index([usuarioId], map: "ix_verification_tokens_user_id")
  // SQL/Alembic, CHECK [ck_verification_purpose]: purpose IN ('verify','reset').
  @@map("verification_tokens")
}


// tokenHash conserva solo el hash; familiaId permite revocar todos los sucesores ante replay.
// familiaId es una agrupación lógica sin tabla/FK propia; reemplazadoPor sí tiene FK autorreferencial.
model RefreshToken {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  usuarioId String @map("user_id") @db.Text
  familiaId String @map("family_id") @db.Text
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  versionAutenticacion Int @map("auth_version") @db.Integer
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  expiraAt DateTime @map("expires_at") @db.Timestamptz(6)
  rotadoAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  revocadoAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  dispositivoId String? @map("device_id") @db.Text
  reemplazadoPorId String? @map("replaced_by_id") @db.Text

  dispositivo Dispositivo? @relation("refresh_sessions_device_id", fields: [dispositivoId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_refresh_sessions_device_id")
  reemplazadoPor RefreshToken? @relation("refresh_sessions_replaced_by_id", fields: [reemplazadoPorId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_refresh_sessions_replaced_by_id")
  tokensReemplazados RefreshToken[] @relation("refresh_sessions_replaced_by_id")
  usuario Usuario @relation("refresh_sessions_user_id", fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiraAt], map: "ix_refresh_sessions_expiry")
  @@index([familiaId], map: "ix_refresh_sessions_family_id")
  @@index([usuarioId], map: "ix_refresh_sessions_user_id")
  @@index([usuarioId, revocadoAt], map: "ix_refresh_sessions_user_revoked")
  @@map("refresh_sessions")
}


// El token crudo es privado. La unicidad SQL recae en tokenHash, no en un índice sobre token TEXT.
// familiaSesionId es una asociación lógica sin FK; logout elimina solo dispositivos de esa familia.
model Dispositivo {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  usuarioId String @map("user_id") @db.Text
  token String @map("token") @db.Text
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  plataforma String @map("platform") @db.VarChar(16)
  proveedor String @map("provider") @db.VarChar(16)
  familiaSesionId String @map("session_family_id") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  ultimaActividadAt DateTime @map("last_active_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow(); onupdate=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  entregasPush EntregaPush[] @relation("push_deliveries_device_id")
  refreshTokens RefreshToken[] @relation("refresh_sessions_device_id")
  usuario Usuario @relation("devices_user_id", fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([familiaSesionId], map: "ix_devices_session_family_id")
  @@index([usuarioId], map: "ix_devices_user_id")
  // SQL/Alembic, CHECK [ck_device_platform]: platform IN ('android','ios','web').
  // SQL/Alembic, CHECK [ck_device_platform_provider]: provider = 'fcm' OR (provider = 'apns' AND platform = 'ios') OR (provider = 'webpush' AND platform = 'web').
  // SQL/Alembic, CHECK [ck_device_provider]: provider IN ('fcm','apns','webpush').
  @@map("devices")
}


// averageRating, totalRatings y totalOrders son agregados del DTO; no existen columnas cacheadas.
// ownerId del DTO deriva de la cuenta Cocina activa y aprobada; no existe administradorId en businesses.
// cuentasCocina es una relación plural en SQL; la restricción de operador vigente es parcial.
model Negocio {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  nombre String @map("name") @db.VarChar(160)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
  categoria String @map("category") @db.VarChar(80)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="".
