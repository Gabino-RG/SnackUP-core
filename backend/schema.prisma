}


// El bloqueo/transacción SQL completa la solicitud; no existen columnas estado ni codigoHttp.
// pedidoId NO es único global en SQL; solo usuarioId + clave tiene unicidad.
// respuesta es un DTO privado y nunca debe publicarse como evento o registro de acceso.
model ClaveIdempotencia {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  usuarioId String @map("user_id") @db.Text
  clave String @map("key") @db.VarChar(128)
  hashSolicitud String @map("payload_hash") @db.VarChar(64)
  pedidoId String @map("order_id") @db.Text
  respuesta Json @map("response_json") @db.Json
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  expiraAt DateTime? @map("expires_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  pedido Pedido @relation("idempotency_records_order_id", fields: [pedidoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usuario Usuario @relation("idempotency_records_user_id", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([usuarioId, clave], map: "uq_user_order_idempotency")
  @@map("idempotency_records")
}


// Auditoría de seguridad sin contraseñas, tokens ni códigos de retiro; recursoId es una referencia polimórfica sin FK.
model EventoAuditoriaCuenta {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  actorId String? @map("actor_id") @db.Text
  accion String @map("action") @db.VarChar(80)
  tipoRecurso String @map("target_type") @db.VarChar(32)
  recursoId String @map("target_id") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=dict().
  datos Json @map("data") @db.Json
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  actor Usuario? @relation("account_audit_events_actor_id", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([actorId], map: "ix_account_audit_events_actor_id")
  @@index([tipoRecurso, recursoId], map: "ix_account_audit_target")
  @@map("account_audit_events")
}


// id es el consecutivo SQL interno; eventoId es el identificador público estable para deduplicación.
// La publicación registra intentos, error y próximo intento; payloads de eventos excluyen credenciales y pickupCode.
model EventoSalida {
  id Int @id @default(autoincrement()) @map("id") @db.Integer
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  eventoId String @unique @map("event_id") @db.VarChar(32)
  canal String @map("topic") @db.Text
  tipo String @map("event_type") @db.VarChar(80)
  datos Json @map("data") @db.Json
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  publicadoAt DateTime? @map("published_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=0.
  intentosPublicacion Int @map("publish_attempts") @db.Integer
  ultimoError String? @map("last_error") @db.VarChar(80)
  proximoIntentoAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)

  entregasPush EntregaPush[] @relation("push_deliveries_outbox_event_id")

  @@index([proximoIntentoAt], map: "ix_outbox_events_next_attempt_at")
  @@index([publicadoAt], map: "ix_outbox_events_published_at")
  @@index([canal], map: "ix_outbox_events_topic")
  @@map("outbox_events")
}


// Una entrega durable por evento de outbox y dispositivo, con reintentos, reserva y resultado del proveedor.
// eventoSalidaId referencia el entero interno de outbox; eventoId duplica el ID público sin otra FK.
// sent significa aceptación del proveedor, no lectura o presentación por el sistema operativo.
model EntregaPush {
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=new_id().
  id String @id @map("id") @db.Text
  eventoSalidaId Int @map("outbox_event_id") @db.Integer
  eventoId String @map("event_id") @db.Text
  dispositivoId String? @map("device_id") @db.Text
  usuarioId String @map("user_id") @db.Text
  datos Json @map("payload") @db.Json
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default="pending".
  estado String @map("state") @db.VarChar(16)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=0.
  intentos Int @map("attempts") @db.Integer
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  proximoIntentoAt DateTime @map("next_attempt_at") @db.Timestamptz(6)
  bloqueadoHasta DateTime? @map("locked_until") @db.Timestamptz(6)
  reservaId String? @map("lease_id") @db.Text
  ultimoError String? @map("last_error") @db.VarChar(80)
  mensajeProveedorId String? @map("provider_message_id") @db.Text
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow().
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  // SQLAlchemy, aplicación (sin DEFAULT SQL): default=utcnow(); onupdate=utcnow().
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  enviadoAt DateTime? @map("sent_at") @db.Timestamptz(6)

  dispositivo Dispositivo? @relation("push_deliveries_device_id", fields: [dispositivoId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  eventoSalida EventoSalida @relation("push_deliveries_outbox_event_id", fields: [eventoSalidaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario Usuario @relation("push_deliveries_user_id", fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventoSalidaId, dispositivoId], map: "uq_push_event_device")
  @@index([estado, proximoIntentoAt], map: "ix_push_due")
  // SQL/Alembic, CHECK [ck_push_attempts]: attempts >= 0.
  // SQL/Alembic, CHECK [ck_push_state]: state IN ('pending','sending','retry','unconfigured','sent','dead','cancelled').
  @@map("push_deliveries")
}
