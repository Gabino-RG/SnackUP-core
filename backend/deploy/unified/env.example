# Copy to backend/.env. Generate EACH secret separately with: openssl rand -hex 32
# Use a DNS name only, without https://, path or port. Point DNS at this server.
SNACKUP_DOMAIN=snackup.example.edu
TLS_ACME_EMAIL=operations@example.edu
POSTGRES_DB=snackup
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=
SNACKUP_DB_USER=snackup
SNACKUP_DB_PASSWORD=
SNACKUP_SECRET_KEY=
SNACKUP_INSTITUTION_ID=utsjr
SNACKUP_INSTITUTION_NAME=Universidad Tecnologica de San Juan del Rio
SNACKUP_CAFETERIA_ID=campus-utsjr
SNACKUP_CAFETERIA_NAME=Cafeterias UTSJR
SNACKUP_ADMIN_EMAIL_DOMAINS=utsjr.edu.mx
SNACKUP_STUDENT_EMAIL_DOMAINS=utsjr.edu.mx
SNACKUP_WORKERS=2
# SMTP and the authorized institutional roster must be configured before signup.
SNACKUP_SMTP_HOST=
SNACKUP_SMTP_PORT=587
SNACKUP_SMTP_USER=
SNACKUP_SMTP_PASSWORD=
SNACKUP_SMTP_FROM=
SNACKUP_SMTP_STARTTLS=true
SNACKUP_PUSH_ENABLED=false
# Optional: local checkouts instead of the exact Git SHAs in Compose.
# SNACKUP_USERS_CONTEXT=../../snackup-users
# SNACKUP_PANELS_CONTEXT=../../snackup-panels
