# Shared by the public HTTPS site and the loopback-only readiness listener.
(snackup_routes) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
	request_body {
		max_size 6MB
	}
	route {
		@backend path /api /api/* /socket.io /socket.io/* /media /media/* /health /health/*
		handle @backend {
			reverse_proxy {$SNACKUP_UPSTREAMS:127.0.0.1:8000} {
                lb_policy least_conn
                # Arrival time for the API admission budget; replaces any client value.
                header_up X-Snackup-Edge-Ms {time.now.unix_ms}
                transport http {
                    keepalive 30s
                }
            }
		}
		redir /paneles /paneles/ 308
		handle_path /paneles/* {
			root * {$SNACKUP_PANELS_WEB:/srv/paneles}
			header Cache-Control no-cache
			@panels_asset path_regexp panels_asset \.[^/]+$
			handle @panels_asset {
				file_server
			}
			handle {
				try_files {path} /index.html
				file_server
			}
		}
		handle {
			root * {$SNACKUP_USERS_WEB:/srv/usuarios}
			header Cache-Control no-cache
			@users_asset path_regexp users_asset \.[^/]+$
			handle @users_asset {
				file_server
			}
			handle {
				try_files {path} /index.html
				file_server
			}
		}
	}
}
