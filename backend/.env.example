# Copy to .env locally; never commit .env or real institution/credential data.
# Development defaults. Compose overrides environment/database/media for production.
SNACKUP_ENVIRONMENT=development
SNACKUP_DATABASE_URL=sqlite:///./data/snackup.db
# Required: generate privately, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SNACKUP_SECRET_KEY=
SNACKUP_PUBLIC_ORIGIN=http://localhost:8000
# Same-origin frontend base path for recovery links; use /paneles/ for the combined apps deployment.
SNACKUP_PASSWORD_RESET_FRONTEND_PATH=/

# Fill with the real, approved values. No domain or student identity is inferred.
SNACKUP_INSTITUTION_ID=
SNACKUP_INSTITUTION_NAME=
SNACKUP_CAFETERIA_ID=
SNACKUP_CAFETERIA_NAME=
SNACKUP_ADMIN_EMAIL_DOMAINS=
SNACKUP_STUDENT_EMAIL_DOMAINS=

SNACKUP_MEDIA_DIR=./data/media
# Optional compiled frontend: uncomment only when this directory has index.html.
# SNACKUP_WEB_DIR=/absolute/path/to/compiled/frontend
SNACKUP_REDIS_URL=
SNACKUP_POOL_SIZE=10
SNACKUP_MAX_OVERFLOW=5
# Bounded SQL admission and fixed password threads; use 2 password threads on 2 vCPU.
SNACKUP_POOL_TIMEOUT_SECONDS=2
SNACKUP_ADMISSION_WAIT_SECONDS=5
SNACKUP_LOGIN_WAIT_SECONDS=8
SNACKUP_PASSWORD_CONCURRENCY=4
SNACKUP_OUTBOX_RETENTION_DAYS=7
SNACKUP_OUTBOX_CLEANUP_BATCH=1000
SNACKUP_ACCESS_TOKEN_MINUTES=15
SNACKUP_REFRESH_DAYS=30
SNACKUP_MAX_WEBSOCKETS=2000
SNACKUP_WEBSOCKET_REVALIDATE_SECONDS=15

# Registration/recovery depend on a configured SMTP service; no fake success.
SNACKUP_SMTP_HOST=
SNACKUP_SMTP_PORT=587
SNACKUP_SMTP_USER=
SNACKUP_SMTP_PASSWORD=
SNACKUP_SMTP_FROM=
SNACKUP_SMTP_STARTTLS=true

# Docker Compose production only. Use distinct URL-safe random hex passwords.
SNACKUP_DOMAIN=
TLS_ACME_EMAIL=
POSTGRES_DB=snackup
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=
POSTGRES_STATEMENT_TIMEOUT_MS=20000
POSTGRES_LOCK_TIMEOUT_MS=5000
SNACKUP_DB_USER=snackup
SNACKUP_DB_PASSWORD=
REDIS_PASSWORD=
# Choose a subnet that does not overlap the university/VPN/Docker networks.
SNACKUP_EDGE_SUBNET=172.30.8.0/28
# Dynamic pool must be inside the subnet and exclude the fixed proxy IP.
SNACKUP_EDGE_IP_RANGE=172.30.8.8/29
SNACKUP_PROXY_IP=172.30.8.2
SNACKUP_WORKERS=2
# Optional deploy/compose.frontend.yaml: absolute host path of reviewed web build.
# SNACKUP_FRONTEND_DIR=/absolute/path/to/compiled/frontend

# Socket.IO is exposed at /socket.io with the websocket transport only.
# Push transport is optional until the institution provides credentials.
# Credential files are mounted read-only; never store service keys in git.
SNACKUP_PUSH_ENABLED=false
# SNACKUP_PUSH_FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json
# SNACKUP_PUSH_FCM_PROJECT_ID=
# SNACKUP_PUSH_APNS_KEY_FILE=/run/secrets/apns-auth.p8
# SNACKUP_PUSH_APNS_KEY_ID=
# SNACKUP_PUSH_APNS_TEAM_ID=
# SNACKUP_PUSH_APNS_TOPIC=
# SNACKUP_PUSH_APNS_SANDBOX=false
# SNACKUP_PUSH_WEBPUSH_PRIVATE_KEY_FILE=/run/secrets/webpush.pem
# SNACKUP_PUSH_WEBPUSH_SUBJECT=mailto:responsable@example.edu
