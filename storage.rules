rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function ownsBusiness(businessId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'business'
        && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    match /product_images/{businessId}/{imageId} {
      allow get: if request.auth != null;
      allow create: if ownsBusiness(businessId)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    }

    match /product_images/{legacyImageId} {
      allow get: if request.auth != null;
    }
  }
}
